<Window x:Class="CrealitySparkXWidget.Views.WidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:converters="clr-namespace:CrealitySparkXWidget.Converters"
        mc:Ignorable="d"
        Title="Creality SparkX i7 Widget"
        Width="360"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Topmost="True"
        Deactivated="Window_Deactivated">

    <Window.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
        <converters:BoolToVisibilityConverter x:Key="InvertBoolToVis" Invert="True" />
        <converters:StringToBrushConverter x:Key="StringToBrush" />
        <converters:ValueToPercentageConverter x:Key="ToPercent" />
        <converters:BoolToActiveBorderBrushConverter x:Key="BoolToActiveBorderBrush" />
        <converters:BoolToActiveTextConverter x:Key="BoolToActiveText" />
        <converters:BoolToActiveForegroundConverter x:Key="BoolToActiveForeground" />

        <!-- Minimal Grayscale Card Style (Borderless) -->
        <Style x:Key="CardBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
        </Style>

        <!-- Minimal Grayscale Sensor Tile Style (Borderless) -->
        <Style x:Key="SensorCardStyle" TargetType="Border">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
        </Style>

        <!-- Clean Office Action Button Style -->
        <Style x:Key="RoundButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#9CA3AF" />
            <Setter Property="BorderBrush" Value="#24262B" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="6,3" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#202227" />
                                <Setter TargetName="border" Property="BorderBrush" Value="#353842" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#17181C" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Minimal Accent Button Style -->
        <Style x:Key="AccentButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#10B981" />
            <Setter Property="Foreground" Value="#09140F" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#059669" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#047857" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Outer Minimal Dark Grayscale Container -->
    <Grid Margin="10">
        <Border Background="#111215"
                BorderBrush="#24262B"
                BorderThickness="1"
                CornerRadius="12">
            <Border.Effect>
                <DropShadowEffect BlurRadius="16" ShadowDepth="3" Direction="270" Opacity="0.5" Color="#000000" />
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /> <!-- Header -->
                    <RowDefinition Height="*" />    <!-- Content / Tabs -->
                </Grid.RowDefinitions>

                <!-- HEADER -->
                <Border Grid.Row="0" Background="Transparent" CornerRadius="11,11,0,0" Padding="12,9" BorderBrush="#202227" BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Minimal Printer Badge -->
                        <Border Grid.Column="0" Width="24" Height="24" Background="Transparent" BorderThickness="0" Margin="0,0,8,0">
                            <TextBlock Text="⚡" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#10B981" />
                        </Border>

                        <!-- Title and Status -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Creality SparkX i7" FontWeight="SemiBold" FontSize="12.5" Foreground="#FFFFFF" />
                            <StackPanel Orientation="Horizontal" Margin="0,1,0,0" VerticalAlignment="Center">
                                <Ellipse Width="6" Height="6" Margin="0,0,5,0" VerticalAlignment="Center"
                                         Fill="{Binding StatusColor, Converter={StaticResource StringToBrush}}" />
                                <TextBlock Text="{Binding StatusBadgeText}" FontSize="10" FontWeight="Medium"
                                           Foreground="{Binding StatusColor, Converter={StaticResource StringToBrush}}" VerticalAlignment="Center" />

                                <!-- Polling Activity Ping Icon -->
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0"
                                            ToolTip="{Binding LastUpdatedTooltip}">
                                    <TextBlock Text="🔄" FontSize="10" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                        <TextBlock.RenderTransform>
                                            <RotateTransform Angle="0" />
                                        </TextBlock.RenderTransform>
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#4B5563" />
                                                <Setter Property="Opacity" Value="0.35" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsPollPulse}" Value="True">
                                                        <Setter Property="Foreground" Value="#10B981" />
                                                        <Setter Property="Opacity" Value="1.0" />
                                                        <DataTrigger.EnterActions>
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                                     By="180" Duration="0:0:0.35" />
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </DataTrigger.EnterActions>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="{Binding LastUpdatedShort}" FontSize="8.5" Foreground="#6B7280" Margin="3,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>

                        <!-- Header Action Buttons -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource RoundButtonStyle}" Command="{Binding OpenWebDashboardCommand}"
                                    ToolTip="Apri Dashboard Web nel Browser" Width="26" Height="26" Padding="0" Margin="0,0,5,0">
                                <TextBlock Text="🌐" FontSize="11" />
                            </Button>
                            <Button Style="{StaticResource RoundButtonStyle}" Command="{Binding ToggleSettingsCommand}"
                                    ToolTip="Impostazioni" Width="26" Height="26" Padding="0" Margin="0,0,5,0">
                                <TextBlock Text="⚙" FontSize="11" />
                            </Button>
                            <Button Style="{StaticResource RoundButtonStyle}" Click="CloseButton_Click"
                                    ToolTip="Chiudi / Nascondi" Width="26" Height="26" Padding="0">
                                <TextBlock Text="✕" FontSize="10" FontWeight="SemiBold" Foreground="#828792" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- TAB 1: TELEMETRY DASHBOARD -->
                <Grid Grid.Row="1" Visibility="{Binding IsSettingsOpen, Converter={StaticResource InvertBoolToVis}}">
                    <StackPanel Margin="11,9" VerticalAlignment="Top">

                        <!-- OFFLINE NOTICE -->
                        <Border Style="{StaticResource CardBorderStyle}"
                                Background="Transparent" BorderBrush="#451D24"
                                Margin="0,0,0,9"
                                Visibility="{Binding IsOffline, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <TextBlock Text="⚠️" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Stampante non raggiungibile" FontWeight="SemiBold" FontSize="11.5" Foreground="#F87171" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Text="Verifica che la Creality SparkX i7 sia accesa e raggiungibile sulla porta 7125."
                                           FontSize="10.5" Foreground="#9CA3AF" TextWrapping="Wrap" Margin="0,0,0,8" />
                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource AccentButtonStyle}" Command="{Binding ReconnectCommand}" Content="Riconnetti" FontSize="10.5" Margin="0,0,6,0" />
                                    <Button Style="{StaticResource RoundButtonStyle}" Command="{Binding ToggleDemoModeCommand}" Content="Attiva Demo" FontSize="10.5" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- ACTIVE JOB CARD (When Printing or Paused) -->
                        <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,8"
                                Visibility="{Binding IsPrinting, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <!-- File Name -->
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="📦" FontSize="12" Margin="0,0,5,0" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding Telemetry.CurrentFile, FallbackValue='modello_3d.gcode'}"
                                               FontWeight="SemiBold" FontSize="11.5" Foreground="#FFFFFF"
                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                </Grid>

                                <!-- Minimal Slim Progress Bar -->
                                <Grid Margin="0,2,0,6">
                                    <ProgressBar Height="5" Value="{Binding Telemetry.ProgressPercentage}" Minimum="0" Maximum="100"
                                                 BorderThickness="0" Background="#222429" Foreground="#10B981" />
                                </Grid>

                                <!-- Progress % and Times -->
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Telemetry.ProgressPercentage, StringFormat='{}{0:F0}%'}"
                                               FontSize="16" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding TimeFormatted}" FontSize="10" Foreground="#828792" HorizontalAlignment="Right" />
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,1,0,0">
                                            <TextBlock Text="ETA: " FontSize="10" Foreground="#6B7280" />
                                            <TextBlock Text="{Binding ETAFormatted}" FontSize="10" FontWeight="SemiBold" Foreground="#FFFFFF" />
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>

                                <!-- DETAILED ACTIVITY / PHASE BANNER -->
                                <Border Padding="0,2" Margin="0,0,0,6"
                                        Background="Transparent" BorderThickness="0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="{Binding DetailedActivityIcon}" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center" />

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <Grid>
                                                <TextBlock Text="{Binding DetailedActivityTitle}" FontWeight="SemiBold" FontSize="10.5"
                                                           Foreground="{Binding DetailedActivityColor, Converter={StaticResource StringToBrush}}" />
                                                <TextBlock Text="{Binding SlicerMessage}" HorizontalAlignment="Right" FontSize="9"
                                                           Foreground="#6B7280" MaxWidth="140" TextTrimming="CharacterEllipsis"
                                                           Visibility="{Binding HasSlicerMessage, Converter={StaticResource BoolToVis}}" />
                                            </Grid>
                                            <TextBlock Text="{Binding DetailedActivityDescription}" FontSize="9.5" Foreground="#9CA3AF" Margin="0,1,0,0" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Separator Background="#222429" Margin="0,1,0,6" />

                                <!-- Layers, Z Height and Speed -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Layer -->
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="LAYER" FontSize="8.5" FontWeight="SemiBold" Foreground="#6B7280" />
                                        <TextBlock Text="{Binding LayerDisplay}" FontSize="11" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,1,0,0" />
                                    </StackPanel>

                                    <!-- Z Height -->
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="QUOTA Z" FontSize="8.5" FontWeight="SemiBold" Foreground="#6B7280" />
                                        <TextBlock Text="{Binding ZDisplay}" FontSize="11" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,1,0,0" />
                                    </StackPanel>

                                    <!-- Speed -->
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="VELOCITÀ" FontSize="8.5" FontWeight="SemiBold" Foreground="#6B7280" />
                                        <TextBlock Text="{Binding SpeedDisplay}" FontSize="11" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,1,0,0" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                        <Separator Background="#202227" Margin="0,0,0,9" Visibility="{Binding IsPrinting, Converter={StaticResource BoolToVis}}" />

                        <!-- CFS MULTI-COLOR (If present) -->
                        <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,8"
                                Visibility="{Binding HasCfs, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <Grid Margin="0,0,0,6">
                                    <TextBlock Text="SISTEMA FILAMENTI (CFS)" FontSize="9" FontWeight="SemiBold" Foreground="#828792" VerticalAlignment="Center" />
                                    <TextBlock Text="4 Slot" FontSize="8.5" Foreground="#6B7280" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                                <ItemsControl ItemsSource="{Binding CfsSlots}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="4" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="2,3" Margin="2,0" Background="Transparent"
                                                    BorderThickness="0">
                                                <StackPanel HorizontalAlignment="Center">
                                                    <Grid Width="18" Height="18" Margin="0,0,0,3">
                                                        <Ellipse Fill="{Binding ColorHex, Converter={StaticResource StringToBrush}}"
                                                                 Stroke="#374151" StrokeThickness="1" />
                                                        <TextBlock Text="✓" FontSize="9" FontWeight="Bold" Foreground="#FFFFFF"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                   Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}" />
                                                    </Grid>
                                                    <TextBlock Text="{Binding DisplayName}" FontSize="8.5" FontWeight="Medium"
                                                               Foreground="#E5E7EB" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding IsActive, Converter={StaticResource BoolToActiveText}}"
                                                               Foreground="{Binding IsActive, Converter={StaticResource BoolToActiveForeground}}"
                                                               FontSize="7.5" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,1,0,0" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                        <Separator Background="#202227" Margin="0,0,0,9" Visibility="{Binding HasCfs, Converter={StaticResource BoolToVis}}" />

                        <!-- IDLE NOTICE (When Connected but not printing) -->
                        <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,8"
                                Visibility="{Binding IsIdle, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                    <TextBlock Text="{Binding DetailedActivityIcon}" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding DetailedActivityTitle}" FontWeight="SemiBold" FontSize="11.5"
                                               Foreground="{Binding DetailedActivityColor, Converter={StaticResource StringToBrush}}" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Text="{Binding DetailedActivityDescription}"
                                           FontSize="10" Foreground="#9CA3AF" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <Separator Background="#202227" Margin="0,0,0,9" Visibility="{Binding IsIdle, Converter={StaticResource BoolToVis}}" />

                        <!-- SENSORS & TEMPERATURES TITLE -->
                        <TextBlock Text="SENSORI &amp; TEMPERATURE" FontSize="9" FontWeight="SemiBold"
                                   Foreground="#828792" Margin="2,0,0,6" />

                        <!-- SENSORS GRID 2x2 -->
                        <Grid Margin="0,0,0,8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- NOZZLE / EXTRUDER CARD -->
                            <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource SensorCardStyle}" Margin="0,0,8,8">
                                <StackPanel>
                                    <Grid Margin="0,0,0,2">
                                        <TextBlock Text="🔥 Ugello" FontSize="10" FontWeight="Medium" Foreground="#F87171" />
                                        <TextBlock HorizontalAlignment="Right" FontSize="9" Foreground="#6B7280">
                                            <Run Text="Set: " />
                                            <Run Text="{Binding Telemetry.TargetNozzleTemperature, StringFormat='{}{0:F0} °C'}" Foreground="#9CA3AF" />
                                        </TextBlock>
                                    </Grid>
                                    <TextBlock Text="{Binding Telemetry.NozzleTemperature, StringFormat='{}{0:F1} °C'}"
                                               FontSize="15" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,1,0,3" />
                                    <ProgressBar Height="3" Value="{Binding Telemetry.NozzleTemperature}" Minimum="0" Maximum="300"
                                                 BorderThickness="0" Background="#222429" Foreground="#EF4444" />
                                </StackPanel>
                            </Border>

                            <!-- BED CARD -->
                            <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource SensorCardStyle}" Margin="8,0,0,8">
                                <StackPanel>
                                    <Grid Margin="0,0,0,2">
                                        <TextBlock Text="♨️ Piatto" FontSize="10" FontWeight="Medium" Foreground="#FBBF24" />
                                        <TextBlock HorizontalAlignment="Right" FontSize="9" Foreground="#6B7280">
                                            <Run Text="Set: " />
                                            <Run Text="{Binding Telemetry.TargetBedTemperature, StringFormat='{}{0:F0} °C'}" Foreground="#9CA3AF" />
                                        </TextBlock>
                                    </Grid>
                                    <TextBlock Text="{Binding Telemetry.BedTemperature, StringFormat='{}{0:F1} °C'}"
                                               FontSize="15" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,1,0,3" />
                                    <ProgressBar Height="3" Value="{Binding Telemetry.BedTemperature}" Minimum="0" Maximum="110"
                                                 BorderThickness="0" Background="#222429" Foreground="#F59E0B" />
                                </StackPanel>
                            </Border>

                            <!-- CHAMBER / MCU CARD -->
                            <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource SensorCardStyle}" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="{Binding SecondarySensorTitle}" FontSize="10" FontWeight="Medium" Foreground="#38BDF8" Margin="0,0,0,2" />
                                    <TextBlock Text="{Binding SecondarySensorValue}"
                                               FontSize="15" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,1,0,1" />
                                    <TextBlock Text="{Binding SecondarySensorSubtext}" FontSize="8.5" Foreground="#6B7280" />
                                </StackPanel>
                            </Border>

                            <!-- COOLING FAN CARD -->
                            <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource SensorCardStyle}" Margin="8,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="🌀 Ventola" FontSize="10" FontWeight="Medium" Foreground="#34D399" Margin="0,0,0,2" />
                                    <TextBlock Text="{Binding FanDisplay}"
                                               FontSize="15" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,1,0,1" />
                                    <TextBlock Text="Raffreddamento pezzo" FontSize="8.5" Foreground="#6B7280" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- QUICK FOOTER BAR -->
                        <Border Margin="0,4,0,0" Padding="0,2,0,0">
                            <Grid>
                                <TextBlock Text="{Binding FooterStatusDisplay, FallbackValue='Pronto'}"
                                           FontSize="9" Foreground="#6B7280" VerticalAlignment="Center" />
                                <Button Style="{StaticResource RoundButtonStyle}" Command="{Binding ReconnectCommand}"
                                        HorizontalAlignment="Right" Padding="6,2" FontSize="9.5">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🔄 " FontSize="8.5" />
                                        <TextBlock Text="Aggiorna" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- TAB 2: SETTINGS PANEL -->
                <Grid Grid.Row="1" Visibility="{Binding IsSettingsOpen, Converter={StaticResource BoolToVis}}">
                    <StackPanel Margin="12,10" VerticalAlignment="Top">
                        <TextBlock Text="Impostazioni Creality SparkX i7" FontWeight="SemiBold" FontSize="12.5" Foreground="#FFFFFF" Margin="0,0,0,10" />

                        <!-- IP / HOST -->
                        <TextBlock Text="Indirizzo IP o Hostname Stampante:" FontSize="10" FontWeight="Medium" Foreground="#9CA3AF" Margin="0,0,0,3" />
                        <TextBox Text="{Binding SettingsHost, UpdateSourceTrigger=PropertyChanged}"
                                 Background="Transparent" Foreground="#FFFFFF" BorderBrush="#24262B" BorderThickness="1"
                                 Padding="7,5" FontSize="11" Margin="0,0,0,8" />

                        <!-- PORT -->
                        <TextBlock Text="Porta Moonraker (predefinita: 7125):" FontSize="10" FontWeight="Medium" Foreground="#9CA3AF" Margin="0,0,0,3" />
                        <TextBox Text="{Binding SettingsPort, UpdateSourceTrigger=PropertyChanged}"
                                 Background="Transparent" Foreground="#FFFFFF" BorderBrush="#24262B" BorderThickness="1"
                                 Padding="7,5" FontSize="11" Margin="0,0,0,8" />

                        <!-- REFRESH INTERVAL -->
                        <TextBlock Text="Intervallo di aggiornamento (secondi):" FontSize="10" FontWeight="Medium" Foreground="#9CA3AF" Margin="0,0,0,3" />
                        <TextBox Text="{Binding SettingsRefreshInterval, UpdateSourceTrigger=PropertyChanged}"
                                 Background="Transparent" Foreground="#FFFFFF" BorderBrush="#24262B" BorderThickness="1"
                                 Padding="7,5" FontSize="11" Margin="0,0,0,10" />

                        <!-- CHECKBOXES -->
                        <CheckBox IsChecked="{Binding SettingsAutoConnect}" Content="Connetti automaticamente all'avvio"
                                  Foreground="#D1D5DB" FontSize="10.5" Margin="0,0,0,6" />

                        <CheckBox IsChecked="{Binding SettingsStartWithWindows}" Content="Avvia con Windows nella barra delle applicazioni"
                                  Foreground="#D1D5DB" FontSize="10.5" Margin="0,0,0,6" />

                        <CheckBox IsChecked="{Binding SettingsDemoMode}" Content="Abilita Modalità Simulazione / Demo (Offline)"
                                  Foreground="#FBBF24" FontSize="10.5" Margin="0,0,0,12" />

                        <!-- BUTTONS -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource RoundButtonStyle}" Command="{Binding CancelSettingsCommand}"
                                    Content="Annulla" Margin="0,0,6,0" Padding="10,5" FontSize="10.5" />
                            <Button Style="{StaticResource AccentButtonStyle}" Command="{Binding SaveSettingsCommand}"
                                    Content="Salva e Applica" Padding="12,5" FontSize="10.5" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>